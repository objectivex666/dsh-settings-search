{
  "name": "@objectivex666/dsh-settings-search",
  "version": "1.7.1",
  "description": "DSH settings panel search plugin – instantly filter setting sections and general items with navigation guidance. Installable via `dsh plugin add`.",
  "keywords": [
    "dsh",
    "cordis",
    "settings",
    "search",
    "plugin",
    "koishi",
    "chatbot"
  ],
  "homepage": "https://github.com/objectivex666/dsh-settings-search#readme",
  "bugs": {
    "url": "https://github.com/objectivex666/dsh-settings-search/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/objectivex666/dsh-settings-search.git"
  },
  "license": "GPL-3.0",
  "author": "objectivex666",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node scripts/check.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
